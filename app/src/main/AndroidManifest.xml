<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Auto-capture of bank alerts. RECEIVE_SMS only: there is no inbox backfill,
         so READ_SMS is deliberately not requested. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!--
        The app has no network access, and this is what keeps it that way.

        Manifest merging pulls in permissions declared by libraries, so a dependency
        added years from now could give this app INTERNET without anyone deciding to.
        tools:node="remove" strips it from the merged manifest whatever asks for it,
        and the verifyNoInternetPermission Gradle task fails the build if it survives.

        This matters more than an ordinary permission choice. "Your bank messages
        cannot leave this phone" is checkable by anyone with aapt, which is a very
        different claim from one that has to be taken on trust - and it stops being
        checkable the moment this line goes missing.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <!-- Budget alerts. Required at runtime from Android 13; without it the
         notifications silently never appear. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".FinanceApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FinanceManager">

        <!-- singleTop so a widget tap re-routes the running app through onNewIntent
             instead of stacking a second copy of it on top of itself. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.FinanceManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SMS_RECEIVED is a high-priority broadcast and wakes the app even in Doze,
             so no foreground service or WorkManager scheduling is needed. -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- The home screen widget. ACTION_DATE_CHANGED is here rather than in a
             separate receiver because the only thing it does is ask this provider to
             redraw, and it is the one figure that moves with no user action behind it. -->
        <receiver
            android:name=".widget.SpendingWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_spending_info" />
        </receiver>

    </application>
</manifest>
