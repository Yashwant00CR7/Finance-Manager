<?xml version="1.0" encoding="utf-8"?>
<!--
    Two layers only: the trough and what has been spent. There is deliberately no
    third "remaining" layer - the gap IS the remaining money, and drawing it as its
    own colour invites reading the bar as two quantities instead of one.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#FF7FD1A6" />
                <corners android:radius="6dp" />
            </shape>
        </clip>
    </item>
</layer-list>
